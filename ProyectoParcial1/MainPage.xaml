<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProyectoParcial1.ViewModels"
             x:Class="ProyectoParcial1.MainPage">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Button Text="Cargar Datos" 
                    Command="{Binding LoadPokemonsCommand}" 
                    HeightRequest="50"
                    FontSize="16" />

            <Label Text="{Binding StatusMessage}" 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Pokemons}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="10" CornerRadius="8">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Id}" FontAttributes="Bold" />
                                <Label Text="{Binding Name}" FontSize="18" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>