<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ProyectoParcial1.DetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del Pokémon">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Detalle del Pokémon"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Image
                Source="{Binding ImageUrl}"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Name}"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="10">

                <Label FontSize="18">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Número: " FontAttributes="Bold" />
                            <Span Text="{Binding Id}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label FontSize="18">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Altura: " FontAttributes="Bold" />
                            <Span Text="{Binding Height}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label FontSize="18">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Peso: " FontAttributes="Bold" />
                            <Span Text="{Binding Weight}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>